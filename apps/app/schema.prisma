datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  email                     String?         @unique
  username                  String?         @unique
  tgChatId                  String?         @unique
  tz                        String          @default("UTC")
  isAdmin                   Boolean         @default(false)

  paymentProcessorUserId    String?         @unique
  lemonSqueezyCustomerPortalUrl String?
  subscriptionStatus        String?
  subscriptionPlan          String?
  datePaid                  DateTime?
  credits                   Int             @default(3)

  profiles                  Profile[]
  subscriptions             Subscription[]
  contactFormMessages       ContactFormMessage[]
}

model Profile {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
  userId         String

  name           String
  city           String
  side           String   @default("rent")
  minPriceCents  Int      @default(0)
  maxPriceCents  Int      @default(0)
  minBedrooms    Int      @default(1)
  radiusKm       Float    @default(5.0)
  extras         Json     @default("{}")
  status         String   @default("active")

  matches        Match[]

  @@index([userId])
  @@index([city, status])
}

model Listing {
  id             String   @id @default(uuid())
  sourceKey      String
  city           String
  side           String
  priceCents     Int
  sqm            Int?
  bedrooms       Int?
  addressNorm    String
  publishedAt    DateTime
  lastSeenAt     DateTime @default(now())
  fingerprint    String   @unique

  matches        Match[]

  @@index([city, publishedAt])
  @@index([fingerprint])
}

model Match {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())

  profile        Profile  @relation(fields: [profileId], references: [id])
  profileId      String

  listing        Listing  @relation(fields: [listingId], references: [id])
  listingId      String

  score          Float
  signals        Json     @default("{}")
  matchedAt      DateTime @default(now())
  deliveredEmailAt DateTime?
  deliveredTgAt  DateTime?

  @@unique([profileId, listingId])
  @@index([profileId, matchedAt])
}

model Source {
  id             String   @id @default(uuid())
  key            String   @unique
  cityCoverage   String
  pollIntervalS  Int      @default(60)
  status         String   @default("healthy")
  lastSuccessAt  DateTime?

  @@index([status])
}

model Subscription {
  id             String   @id @default(uuid())
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id])
  userId         String

  tier           String   @default("watch")
  status         String   @default("active")
  endsAt         DateTime?

  @@index([userId, status])
}

model ContactFormMessage {
  id                        String          @id @default(uuid())
  createdAt                 DateTime        @default(now())

  user                      User            @relation(fields: [userId], references: [id])
  userId                    String

  content                   String
  isRead                    Boolean         @default(false)
  repliedAt                 DateTime?
}
