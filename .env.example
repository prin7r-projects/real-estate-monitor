# Public URL used in NOWPayments redirects + IPN callbacks.
NEXT_PUBLIC_SITE_URL=https://real-estate-monitor.prin7r.com

# NOWPayments hosted-invoice + IPN secret. Live keys live only in
# /opt/prin7r-deploys/real-estate-monitor/.env on storage-contabo, never in git.
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
